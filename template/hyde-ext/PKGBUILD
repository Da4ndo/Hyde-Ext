# This PKGBUILD is not a full PKGBUILD
# pkgname, pkgver, source, and sha1sums are to be generated
pkgdesc="Hyde-Ext is a Rust-based command-line application designed to enhance the HyDE (HyDE_CLI) environment. It automates tasks, installs essential tools, manages configurations, and restores settings from backups."
pkgrel=1
arch=(x86_64)
license=(MIT)
url="https://github.com/Da4ndo/Hyde-Ext"
sha256sums=(
  "$_checksum"
)

package() {
  install -Dm755 "hyde-ext-$_checksum" "$pkgdir/usr/bin/hyde-ext"

  # Install assets.meta file to user's home directory
  install -Dm644 assets.meta "$pkgdir/etc/skel/assets.meta"

  # Add a post-upgrade hook to remove the assets directory
  install -Dm755 /dev/null "$pkgdir/usr/share/libalpm/hooks/99-remove-hyde-ext-assets.hook"
  cat << EOF > "$pkgdir/usr/share/libalpm/hooks/99-remove-hyde-ext-assets.hook"
[Trigger]
Type = Package
Operation = Upgrade
Target = hyde-ext

[Action]
Description = Removing old hyde-ext assets directory...
When = PostTransaction
Exec = /usr/bin/rm -rf /usr/share/hyde-ext/
EOF
}